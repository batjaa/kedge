# Single-origin routing for the Kedge preview deployment (issue #27).
# TLS terminates upstream (SWAG → Coolify's proxy); this Caddy only routes.
#
# Order matters: /api/bff/* is a Next.js route handler and must stay on web;
# everything else API-shaped goes to Laravel.
:80 {
	@bff path /api/bff/*
	handle @bff {
		reverse_proxy web:3000
	}

	@api path /api/* /sanctum/* /auth/* /login /logout /register /up /storage/*
	handle @api {
		reverse_proxy api:80 {
			# TLS always terminates upstream of this box, so the public
			# scheme is https by construction. Stamping it here (rather
			# than trusting the variable SWAG/Traefik forwarded-header
			# chain) is what lets the api mint and validate https signed
			# URLs — reviewer magic links (bootstrap trustProxies).
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
