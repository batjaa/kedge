APP_NAME=Kedge
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Kedge edition flag. false = managed SaaS, true = self-hosted deployment.
# Plumbed as config from M0; nothing branches on it yet (see config/kedge.php).
SELF_HOSTED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# --- Cross-app auth handshake (SPEC 4) --------------------------------------
# The web app authenticates against this API with Sanctum SPA session cookies.
# Three knobs express every supported topology — changing deployment shape is
# always an env change, never a code change:
#
#   SESSION_DOMAIN          domain the session + XSRF cookies are scoped to
#   SANCTUM_STATEFUL_DOMAINS  Origin/Referer hosts allowed to use cookie auth
#   CORS_ALLOWED_ORIGINS    comma-separated origins allowed to call the API
#                           with credentials (empty = CORS never engages)
#
# 1. Dev two-port — web on http://localhost:3000, api on http://localhost:8000
#      SESSION_DOMAIN=localhost
#      SANCTUM_STATEFUL_DOMAINS=localhost:3000
#      CORS_ALLOWED_ORIGINS=http://localhost:3000
#
# 2. SaaS split-domain — web on app.kedge.review, api on api.kedge.review
#      SESSION_DOMAIN=.kedge.review
#      SANCTUM_STATEFUL_DOMAINS=app.kedge.review
#      CORS_ALLOWED_ORIGINS=https://app.kedge.review
#
# 3. Self-host single-origin — web + api behind one reverse-proxy origin,
#    e.g. https://kedge.example.com with /api and /sanctum routed here
#      SESSION_DOMAIN=null                # host-only cookie
#      SANCTUM_STATEFUL_DOMAINS=kedge.example.com
#      CORS_ALLOWED_ORIGINS=              # same origin: no CORS involved
#
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Where the API returns the browser after a successful GitHub sign-in — the web
# app's authenticated shell (ticket #6). Same origin as the web app in every
# topology (dev :3000, app.kedge.review, or the self-host single origin).
FRONTEND_URL=http://localhost:3000

# --- GitHub OAuth sign-in (optional, ticket #6) -----------------------------
# One-click sign-in via Socialite. LEAVE BOTH BLANK to disable: the OAuth routes
# 404 and the web app hides the GitHub button (BYO-key pattern, SPEC 14). To
# enable, register an OAuth app at https://github.com/settings/developers with:
#   Application name             Kedge (or your instance name)
#   Homepage URL                 http://localhost:3000            (FRONTEND_URL)
#   Authorization callback URL   http://localhost:8000/auth/github/callback
# then paste the Client ID / generated secret below. The callback URL must match
# APP_URL exactly (the default GITHUB_REDIRECT_URI derives from it).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback   # defaults to APP_URL + /auth/github/callback

# --- Guarded outbound fetching (SSRF guard, SPEC 13) ------------------------
# Caps for the one guarded fetcher every outbound request flows through
# (imports, image re-hosting, demo mode). Callers may override size/timeout per
# call. The scheme allowlist is https-only and not env-tunable by design.
# FETCH_MAX_BYTES=10485760       # 10 MiB response-body ceiling, enforced mid-stream
# FETCH_TIMEOUT=15               # total transfer timeout, seconds
# FETCH_CONNECT_TIMEOUT=5        # connection-establishment timeout, seconds
# FETCH_MAX_REDIRECTS=5          # manual redirect hop cap (each hop re-validated)
#
# FETCH_ALLOW_HOSTS — ⚠ TEST-ONLY. NEVER set this in production or any real
# deployment. Comma-separated hostnames the SSRF guard exempts from its
# private-address rejection (plain http is also permitted for them): a listed
# host is a tunnel straight through the guard. It exists solely so the
# Playwright journeys (#26, #39) can import a fixture document served on
# 127.0.0.1 — web/e2e/serve-api.sh sets it in the throwaway E2E env, and
# nothing else ever should. Empty default = the guard behaves exactly as
# specced (SPEC 13).
# FETCH_ALLOW_HOSTS=

# --- Text projection service (anchor substrate, SPEC 5.4) -------------------
# The web layer owns the plain-text projection. After normalizing content, the
# import job POSTs it to the web app's internal /internal/projection endpoint and
# stores the returned plain_text + projection_version on the version. That
# endpoint is internal (never publicly reachable) and shared-secret guarded, so
# PROJECTION_SHARED_SECRET must match the web app's value exactly.
#
#   PROJECTION_URL             base URL of the web app the API projects against.
#                              Dev two-port: http://localhost:3000. SaaS/self-host:
#                              the internal address of the web deployment.
#   PROJECTION_SHARED_SECRET   the header secret the endpoint requires. Defaults
#                              to a well-known dev value that the web app also
#                              defaults to (so dev imports project with no config);
#                              MUST be set to a real secret on both sides in prod.
#   PROJECTION_TIMEOUT         per-call transfer timeout in seconds.
PROJECTION_URL=http://localhost:3000
PROJECTION_SHARED_SECRET=dev-projection-secret
# PROJECTION_TIMEOUT=10

# --- Manual re-sync + re-anchoring (SPEC 5.3, 8.3) --------------------------
# RESYNC_ENABLED=false makes POST /api/v1/documents/{id}/resync 404 for rollout.
# Re-anchoring calls the web app's internal /internal/reanchor endpoint. It uses
# the same shared-secret guard pattern as projection and defaults to the same web
# app URL/secret in dev.
RESYNC_ENABLED=true
REANCHOR_URL=http://localhost:3000
REANCHOR_SHARED_SECRET=dev-projection-secret
# REANCHOR_TIMEOUT=10

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Re-hosted image storage (SPEC 5.2). Any Laravel disk: `public` (served via the
# /storage symlink) in dev and self-host, an S3/R2 disk on the SaaS. The API also
# caches rendered diagram SVGs here (diagrams/<engine>/<hash>.svg), so readers
# fetch a static <img> from /storage instead of ever contacting Kroki.
MEDIA_DISK=public
# MEDIA_MAX_IMAGE_BYTES=10485760   # per-image guarded-fetch size cap, 10 MiB

# --- Instant demo mode (PLG wedge, SPEC 10.3, #25) — SaaS only --------------
# Disabled entirely when SELF_HOSTED=true (the demo endpoints 404). These are
# growth/abuse levers with conservative sane defaults, tuned at Launch, so they
# stay in config. Fetches inherit the SSRF guard + FETCH_MAX_BYTES ceiling above.
# DEMO_TTL_HOURS=48              # how long an unclaimed demo doc lives before prune
# DEMO_RATE_PER_MINUTE=5        # per-IP burst ceiling on anonymous demo imports
# DEMO_RATE_PER_DAY=40          # per-IP daily ceiling on anonymous demo imports

# --- Diagrams: API-mediated Kroki render cache (SPEC 6.2) -------------------
# Kroki is the sole diagram engine. The API renders each diagram once per
# (engine, source hash) and caches the SVG on MEDIA_DISK; the web's diagram
# component asks the API for the cached URL during render, and the reader only
# ever loads a static <img> — never Kroki, never any diagram code.
#
#   KROKI_URL   base URL of the Kroki service. Hosted https://kroki.io is
#               acceptable in LOCAL DEV ONLY; the self-host compose and the SaaS
#               run their own container (http://kroki:8000) so private diagram
#               source never leaves the deployment. Kroki is a trusted internal
#               service, so this call bypasses the SSRF guard (which would block
#               the internal container) and uses the plain HTTP client instead.
KROKI_URL=https://kroki.io
# KROKI_TIMEOUT=15
# KROKI_CONNECT_TIMEOUT=5
# KROKI_MAX_BYTES=4194304          # rendered-SVG size ceiling, 4 MiB
# KROKI_MAX_SOURCE_BYTES=262144    # per-diagram source ceiling, 256 KiB
#
# DIAGRAM_SHARED_SECRET guards the internal web→api render endpoint (the mirror of
# PROJECTION_SHARED_SECRET, roles swapped). It must match the web app's value
# exactly. No dev default here: the endpoint's middleware supplies a well-known
# dev value the web also defaults to, and FAILS CLOSED in production if unset.
DIAGRAM_SHARED_SECRET=dev-diagram-secret

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Laravel Nightwatch (optional SaaS observability — https://nightwatch.laravel.com).
# Off by default: with no token the package is a full no-op and no agent runs;
# self-hosted instances never need it. Set a token to enable (the deployment
# must also run `php artisan nightwatch:agent` — the preview compose does this
# inside the api container when the token is present).
NIGHTWATCH_TOKEN=
# NIGHTWATCH_ENABLED=   # explicit override; defaults to "token is set"
# NIGHTWATCH_INGEST_URI=127.0.0.1:2407
# NIGHTWATCH_REQUEST_SAMPLE_RATE=1.0

# --- AI features (SPEC 14, M4) ----------------------------------------------
# BYO key. The ENTIRE AI surface — the digest button, the run panel, every
# /ai route — is gated on this key being present. Leave it blank and the
# instance simply has no AI: /api/v1/config reports ai.enabled=false, the web
# renders no AI affordance, and the AI routes 404. Nothing looks broken.
# The key is never sent anywhere but api.anthropic.com, and no test suite ever
# reaches a live model (the SDK's fake covers every path).
ANTHROPIC_API_KEY=
# AI_ENABLED=false       # KILL SWITCH ONLY: can force AI off, never on. Only a
#                        # key turns AI on, so no env typo can surface a button
#                        # backed by no credential.
# AI_MODEL=claude-sonnet-5          # default generation model (SPEC 14)
# AI_SUMMARY_MODEL=claude-haiku-4-5 # cheap high-volume ops (thread summaries)
# AI_CONTEXT_TOKENS=24000  # assembled-input ceiling for ONE model call
# AI_MAX_CHUNKS=4          # max calls per run; the rest is reported as coverage
# AI_MAX_THREADS=500       # threads one assembly may hydrate (worker-memory bound)
# AI_JOB_TIMEOUT=300       # seconds; past it the run lands failed, never stuck
# AI_STALE_AFTER=1800      # seconds before an in-flight run counts as abandoned
# AI_RATE_PER_MINUTE=10    # throttle:ai, per user — a spend bound, not just abuse
