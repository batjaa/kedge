<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!-- The AI surface is off unless a test turns it on with
             config(['kedge.ai.enabled' => true]). Pinned here so a developer
             with a real key in .env can't accidentally green a suite that would
             be red in CI — and so no suite can ever reach a live provider.
             AI_ENABLED=false is the kill switch, which forces the gate off for
             EVERY provider (#140) — a developer running against Ollama or
             OpenAI gets the same off-by-default suite. AI_PROVIDER is pinned
             too, so the provider-keyed pricing table and the agents' provider
             are the certified ones no matter what the developer selected.
             All three are force="true": without it an EXPORTED variable beats
             the value here, and a developer with AI_ENABLED=true and a real key
             in their shell would run a suite CI could never reproduce. -->
        <env name="AI_ENABLED" value="false" force="true"/>
        <env name="AI_PROVIDER" value="anthropic" force="true"/>
        <env name="ANTHROPIC_API_KEY" value="" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:3000"/>
        <env name="SESSION_DOMAIN" value="localhost"/>
        <!-- database (not array): the auth suite asserts real cookie issuance
             and session invalidation, which Laravel skips for non-persistent
             drivers. Sessions land in the in-memory SQLite tests migrate. -->
        <env name="SESSION_DRIVER" value="database"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
